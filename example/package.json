{
	"name": "example",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"generate:cookieSecret": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64url'))\""
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "7.0.1",
		"@sveltejs/kit": "2.68.0",
		"@sveltejs/vite-plugin-svelte": "7.1.2",
		"svelte": "5.56.3",
		"svelte-check": "4.7.5",
		"typescript": "6.0.3",
		"vite": "8.2.1"
	},
	"dependencies": {
		"@sourceregistry/sveltekit-oidc": "^2.1.0"
	}
}
