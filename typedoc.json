{
	"$schema": "https://typedoc.org/schema.json",
	"entryPoints": [
		"src/lib/server/index.ts"
	],
	"entryPointStrategy": "resolve",
	"tsconfig": "tsconfig.typedoc.json",
	"out": "docs",
	"exclude": [
		"**/*.test.ts",
		"src/lib/demo/**"
	],
	"excludePrivate": true,
	"excludeProtected": true,
	"includeVersion": true,
	"highlightLanguages": [
		"bash", "console", "css", "html", "javascript", "json", "jsonc", "json5",
		"yaml", "tsx", "typescript", "dotenv", "mermaid", "svelte"
	],
	"readme": "README.md",
	"name": "sveltekit-oidc"
}
